# Salin ke .env.voting-test.local. Jangan mengubah .env.local milik HIMA.
# Isi hanya koneksi project khusus tes, bukan project HIMA.
VOTING_TEST_PROJECT_REF=ISI_PROJECT_REF_TEST
DATABASE_URL=ISI_TRANSACTION_POOLER_URI
DIRECT_URL=ISI_SESSION_POOLER_URI
# Opsional jika URI masih berisi [YOUR-PASSWORD]. Jangan kirim password ke chat.
VOTING_TEST_DB_PASSWORD=""

# Dibuat otomatis saat file lokal disiapkan; jangan memakai secret voting HIMA.
VOTING_SECRET=GENERATE_RANDOM_TEST_SECRET
VOTING_TEST_ACK=ISOLATED_DUMMY_ONLY
