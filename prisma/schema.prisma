generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberGroup {
  pembina
  pimpinan
  sekretariat
  bendahara
  delegasi
  hh
  psdm
  kominfo
}

enum RegistrationSource {
  web
  spreadsheet
}

model AdminUser {
  id        String   @id @default(uuid()) @db.Uuid
  authId    String   @unique @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Member {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  role        String
  group       MemberGroup
  photoPath   String?
  sortOrder   Int         @default(0)
  isPublished Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@index([isPublished, group, sortOrder])
}

model GalleryPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  alt         String
  imagePath   String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([isPublished, sortOrder])
}

model Registration {
  id                   String             @id @default(uuid()) @db.Uuid
  nama                 String
  nim                  String
  angkatan             String
  period               String
  tempatTanggalLahir   String             @default("")
  jenisKelamin         String             @default("")
  alamat               String             @default("")
  noHp                 String             @default("")
  idLine               String             @default("")
  pengalamanOrganisasi String             @default("")
  minatSkill           String             @default("")
  alasanBergabung       String             @default("")
  divisi               String
  alasanDivisi         String             @default("")
  berkas               String?
  berkasPath           String?
  berkasSize           Int?
  source               RegistrationSource @default(web)
  submittedAt          DateTime?          @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)

  @@unique([nim, period])
  @@index([period, submittedAt])
}

model HeroSlide {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  alt         String
  imagePath   String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([isPublished, sortOrder])
}

enum ProgramStatus {
  upcoming
  open
  closed
}

enum ProgramRegistrationMode {
  external
  internal
}

model Program {
  programPeriod         ProgramPeriod           @relation(fields: [period], references: [period], onDelete: Restrict, onUpdate: Cascade)
  id                    String                  @id @default(uuid()) @db.Uuid
  title                 String
  body                  String
  fullDescription       String                  @default("")
  period                String
  executionDate         String                  @default("")
  time                  String                  @default("")
  location              String                  @default("")
  status                ProgramStatus           @default(upcoming)
  icon                  String                  @default("code")
  gformLink             String                  @default("")
  registrationMode       ProgramRegistrationMode @default(external)
  registrationGroupLink  String                  @default("")
  registrationMaxQuota   Int?
  registrationFormConfig Json                    @default("{}")
  speakers               String[]                @default([])
  benefits              String[]                @default([])
  price                 String                  @default("")
  contactPerson         String                  @default("")
  imagePath             String?
  sortOrder             Int                     @default(0)
  isPublished           Boolean                 @default(true)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  registrations         ProgramRegistration[]

  @@index([isPublished, period, sortOrder])
}

model ProgramRegistration {
  id          String   @id @default(uuid()) @db.Uuid
  programId   String   @db.Uuid
  nama        String
  nim         String
  angkatan    String
  noHp        String   @default("")
  idLine      String   @default("")
  email       String   @default("")
  catatan         String   @default("")
  customResponses Json     @default("{}")
  submittedAt     DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  program     Program  @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@unique([programId, nim])
  @@index([programId, submittedAt])
}

model ProgramPeriod {
  period String @id
  isPublished Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  programs Program[]
}
model RegistrationSettings {
  id String @id @default("main")
  isOpen Boolean @default(true)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Election {
  id String @id @default(uuid()) @db.Uuid
  period String @unique
  status String @default("draft")
  startsAt DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tokenVersion Int @default(0) @map("token_version")
  candidates VotingCandidate[]
  voters EligibleVoter[]
  ballots Ballot[]
  auditLogs VotingAuditLog[]
  resetBackups VotingResetBackup[]
  activeSettings VotingSettings?
  @@map("elections")
}

model VotingSettings {
  id           String    @id @default("main")
  electionId   String?   @unique @map("election_id") @db.Uuid
  adminPinHash String?   @map("admin_pin_hash")
  pinVersion   Int       @default(0) @map("pin_version")
  pinUpdatedAt DateTime? @map("pin_updated_at") @db.Timestamptz(3)
  election     Election? @relation(fields: [electionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@map("voting_settings")
}

model VotingResetBackup {
  id String @id @default(uuid()) @db.Uuid
  electionId String @map("election_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  snapshot Json
  election Election @relation(fields: [electionId], references: [id], onDelete: Restrict)
  @@map("voting_reset_backups")
}

model VotingCandidate {
  id String @id @default(uuid()) @db.Uuid
  electionId String @map("election_id") @db.Uuid
  number Int
  name String @default("")
  vision String @default("")
  missions String[] @default([])
  programs Json @default("[]")
  photoPath String? @map("photo_path")
  placeholder Boolean @default(true)
  election Election @relation(fields: [electionId], references: [id], onDelete: Restrict)
  ballots Ballot[]
  @@unique([electionId, number])
  @@unique([id, electionId])
  @@map("candidates")
}

model EligibleVoter {
  electionId String @map("election_id") @db.Uuid
  voterKey String @map("voter_key")
  name String? @db.VarChar(100)
  eligible Boolean @default(true)
  consumed Boolean @default(false)
  election Election @relation(fields: [electionId], references: [id], onDelete: Restrict)
  @@id([electionId, voterKey])
  @@map("eligible_voters")
}

model Ballot {
  id String @id @default(uuid()) @db.Uuid
  electionId String @map("election_id") @db.Uuid
  candidateId String @map("candidate_id") @db.Uuid
  election Election @relation(fields: [electionId], references: [id], onDelete: Restrict)
  candidate VotingCandidate @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Restrict)
  @@index([electionId, candidateId], map: "ballots_election_candidate")
  @@map("ballots")
}

model VotingAuditLog {
  id String @id @default(uuid()) @db.Uuid
  electionId String @map("election_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  election Election @relation(fields: [electionId], references: [id], onDelete: Restrict)
  @@map("audit_logs")
}

model VotingRateLimit {
  key String @id
  scope String
  hits Int @default(1)
  denied Int @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  @@index([expiresAt], map: "voting_rate_expiry")
  @@map("voting_rate_limits")
}

model VotingHealth {
  code String @id
  count Int @default(1)
  lastSeen DateTime @default(now()) @map("last_seen") @db.Timestamptz
  @@map("voting_health")
}
