# Runtime Prisma: Supabase transaction pooler, biasanya port 6543.
# URL-encode karakter khusus pada password. Jangan menonaktifkan verifikasi TLS.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full

# Prisma CLI: gunakan direct connection atau session pooler port 5432 (IPv4).
DIRECT_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Hanya server. Gunakan secret key Supabase atau legacy service_role key.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

REGISTRATION_PERIOD=2026
NEXT_PUBLIC_SITE_URL=https://www.himaproditiundiknas.id

# Webhook dan EXPORT_SECRET_KEY lama tidak lagi dipakai.
